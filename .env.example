LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Fast model used for normalization and standard extraction
FAST_MODEL=google/gemini-3.8-flash
# Strong model for escalation
STRONG_MODEL=google/gemini-3.1-pro-preview
VISION_MODEL=z-ai/glm-5.3-flash
MAX_WORKERS=4
MAX_LLM_CONCURRENCY=3
MAX_UPLOAD_MB=50
DATABASE_PATH=./data/jobs.sqlite3
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./outputs
OCR_DPI=150
OCR_LANG=eng
LOG_LEVEL=INFO

LLM_TIMEOUT_SECONDS=60
JOB_TIMEOUT_SECONDS=1700
